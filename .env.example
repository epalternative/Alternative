# Resend – envío de correos (Helpdesk IT)
# Obtén tu API key en https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remitente (debe ser un dominio verificado en Resend)
RESEND_FROM_EMAIL=Helpdesk IT <noreply@tudominio.com>

# ——— SMTP (nodemailer): Formulario de contacto + Helpdesk IT + Calculadoras ———
# Hostinger: smtp.hostinger.com; Gmail: smtp.gmail.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# true si 465, false si 587
SMTP_SECURE=true
SMTP_USER=forms@midominio.com
SMTP_PASS=tu_contraseña_del_buzon
MAIL_FROM=forms@midominio.com
# Contacto y Calculadoras: destinatario de /api/contact, /api/madurez-digital y /api/roi-calculator
MAIL_TO=katherine@grupoalternative.com
# Helpdesk IT: destinatarios de /api/helpdesk (varios separados por coma). Si no se define, se usa MAIL_TO.
HELPDESK_MAIL_TO=katherine@grupoalternative.com,support@grupoalternative.com
MAIL_SUBJECT_PREFIX=[Web Form]

# Sanity CMS – Blog (opcional: si no se definen, el blog usa datos estáticos)
NEXT_PUBLIC_SANITY_PROJECT_ID=5s1f6jl3
NEXT_PUBLIC_SANITY_DATASET=production
# Opcional: token de solo lectura para drafts o CORS
# SANITY_API_READ_TOKEN=
